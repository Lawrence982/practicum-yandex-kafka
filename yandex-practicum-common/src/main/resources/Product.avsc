{
  "namespace": "ru.yandex.practicum.model.avro",
  "type": "record",
  "name": "Product",
  "fields": [
    {"name": "productId", "type": "string"},
    {"name": "name", "type": "string"},
    {"name": "sku", "type": "string"},
    {"name": "description", "type": ["null", "string"], "default": null},
    {"name": "category", "type": ["null", "string"], "default": null},
    {"name": "brand", "type": ["null", "string"], "default": null},
    {"name": "createdAt", "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}], "default": null},
    {"name": "updatedAt", "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}], "default": null},
    {"name": "index", "type": ["null", "string"], "default": null},
    {"name": "storeId", "type": ["null", "string"], "default": null},
    {"name": "tags", "type": ["null", {"type": "array", "items": {"type": "string"}}], "default": null},
    {
      "name": "price",
      "type": ["null", {
        "namespace": "ru.yandex.practicum.model.avro",
        "type": "record",
        "name": "Price",
        "fields": [
          {"name": "amount", "type": ["null", "double"], "default": null},
          {"name": "currency", "type": ["null", "string"], "default": null}
        ]
      }],
      "default": null
    },
    {
      "name": "stock",
      "type": ["null", {
        "namespace": "ru.yandex.practicum.model.avro",
        "type": "record",
        "name": "Stock",
        "fields": [
          {"name": "available", "type": ["null", "int"], "default": null},
          {"name": "reserved", "type": ["null", "int"], "default": null}
        ]
      }],
      "default": null
    },
    {
        "name": "images",
        "type": ["null", {
          "type": "array",
          "items": {
            "namespace": "ru.yandex.practicum.model.avro",
            "type": "record",
            "name": "Image",
            "fields": [
              {"name": "url", "type": ["null", "string"], "default": null},
              {"name": "alt", "type": ["null", "string"], "default": null}
            ]
          }
        }],
      "default": null
    },
    {
      "name": "specifications",
      "type": ["null", {
        "namespace": "ru.yandex.practicum.model.avro",
        "type": "record",
        "name": "Specification",
        "fields": [
          {"name": "weight", "type": ["null", "string"], "default": null},
          {"name": "dimensions", "type": ["null", "string"], "default": null},
          {"name": "batteryLife", "type": ["null", "string"], "default": null},
          {"name": "waterResistance", "type": ["null", "string"], "default": null}
        ]
      }],
      "default": null
    }
  ]
}